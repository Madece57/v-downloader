{
  "env": {
    "browser": true,
    "es2022": true,
    "webextensions": true
  },
  "extends": ["eslint:recommended"],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "no-console": "off",
    "no-empty": ["error", { "allowEmptyCatch": true }]
  },
  "globals": {
    "chrome": "readonly",
    "crypto": "readonly"
  },
  "ignorePatterns": ["node_modules/", "lib/"]
}
